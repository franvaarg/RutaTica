# Base SQLite actual (no sustituye ni modifica db/custom.db)
DATABASE_URL="file:../db/custom.db"

# PostgreSQL staging: keep this SQLite default. In a separate shell, export
# DATABASE_URL using the Neon staging connection string (including sslmode=require).
# See docs/POSTGRESQL_STAGING_CONNECTION.md. Never use NEXT_PUBLIC_DATABASE_URL.
# DIRECT_URL is not required by the pinned Prisma 6.19.3 / supported Neon pooler.

# Endpoint completo del API GTFS GraphQL de OpenTripPlanner 2.
# Ejemplo de formato: https://otp.example/otp/gtfs/v1
OPEN_TRIP_PLANNER_URL=

# SQLite paths are relative to prisma/schema.prisma. Deploy only a validated, read-only GTFS snapshot on Vercel.
