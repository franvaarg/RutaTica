// Staging-only client and migration history. The application remains on SQLite.
generator client {
  provider = "prisma-client-js"
  output = "../../node_modules/.prisma/postgresql-staging"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// GTFS Core Tables
// ============================================

model GtfsAgency {
  agency_id String  @id
  name      String
  url       String
  timezone  String
  phone     String?
  lang      String?
  email     String?

  routes GtfsRoute[]
}

model GtfsCalendar {
  service_id String  @id
  monday     Boolean @default(false)
  tuesday    Boolean @default(false)
  wednesday  Boolean @default(false)
  thursday   Boolean @default(false)
  friday     Boolean @default(false)
  saturday   Boolean @default(false)
  sunday     Boolean @default(false)
  start_date String
  end_date   String

}

model GtfsCalendarDate {
  id            Int    @id @default(autoincrement())
  service_id    String
  date          String
  exception_type Int

  @@unique([service_id, date])
  @@index([date, service_id])
}

model GtfsRoute {
  route_id   String  @id
  agency_id  String
  short_name String?
  long_name  String?
  type       Int     @default(3)
  color      String?
  text_color String?
  sort_order Int?

  agency     GtfsAgency  @relation(fields: [agency_id], references: [agency_id])
  trips      GtfsTrip[]
  stopRoutes StopRoute[]
  fareRules  GtfsFareRule[]
  routeColor RouteColor?
  routeLogo  RouteLogo?

  @@index([agency_id])
}

model GtfsStop {
  stop_id           String  @id
  code              String?
  name              String
  desc              String?
  lat               Float
  lon               Float
  zone_id           String?
  location_type     Int     @default(0)
  parent_station    String?
  wheelchair_boarding Int   @default(0)

  stopTimes  GtfsStopTime[]
  stopRoutes StopRoute[]

  @@index([lat, lon])
}

model GtfsTrip {
  trip_id            String  @id
  route_id           String
  service_id         String
  headsign           String?
  short_name         String?
  direction_id       Int?
  block_id           String?
  shape_id           String?
  wheelchair_accessible Int  @default(0)
  bikes_allowed      Int     @default(0)

  route    GtfsRoute    @relation(fields: [route_id], references: [route_id])
  stopTimes GtfsStopTime[]

  @@index([route_id])
  @@index([service_id])
  @@index([shape_id])
}

model GtfsStopTime {
  id                  Int     @id @default(autoincrement())
  trip_id             String
  stop_id             String
  arrival_time        String
  departure_time      String
  stop_sequence       Int
  stop_headsign       String?
  pickup_type         Int     @default(0)
  drop_off_type       Int     @default(0)
  shape_dist_traveled Float?
  timepoint           Int     @default(1)

  trip GtfsTrip @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  stop GtfsStop @relation(fields: [stop_id], references: [stop_id])

  @@index([trip_id])
  @@index([stop_id])
  @@index([arrival_time])
  @@unique([trip_id, stop_sequence])
}

model GtfsShape {
  id                  Int    @id @default(autoincrement())
  shape_id            String
  shape_pt_lat        Float
  shape_pt_lon        Float
  shape_pt_sequence   Int
  shape_dist_traveled Float?

  @@unique([shape_id, shape_pt_sequence])
}

model GtfsFareAttribute {
  fare_id          String  @id
  price            Float
  currency_type    String
  payment_method   Int     @default(0)
  transfers        Int     @default(0)
  transfer_duration Int?

  fareRules GtfsFareRule[]
}

model GtfsFareRule {
  id             Int     @id @default(autoincrement())
  fare_id        String
  route_id       String?
  origin_id      String?
  destination_id String?
  contains_id    String?

  fare GtfsFareAttribute @relation(fields: [fare_id], references: [fare_id], onDelete: Cascade)
  route GtfsRoute?       @relation(fields: [route_id], references: [route_id])
}

// ============================================
// Extended Tables
// ============================================

model Company {
  id            String  @id @default(cuid())
  name          String
  phone         String?
  email         String?
  website       String?
  logoUrl       String?
  description   String?
  primaryColor  String?
  secondaryColor String?
  isActive      Boolean @default(true)
}

model StopRoute {
  id        String  @id @default(cuid())
  stopId    String
  routeId   String
  company   String?
  sequence  Int

  stop  GtfsStop  @relation(fields: [stopId], references: [stop_id])
  route GtfsRoute @relation(fields: [routeId], references: [route_id])

  @@unique([stopId, routeId])
  @@index([routeId, sequence])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  stopName    String
  routeNumber String
  destination String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  originName String
  originLat  Float
  originLon  Float
  destName   String
  destLat    Float
  destLon    Float
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
}

model AppSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model RouteConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?
}

model RouteColor {
  id        String  @id @default(cuid())
  routeId   String  @unique
  color     String
  textColor String

  route GtfsRoute @relation(fields: [routeId], references: [route_id])
}

model RouteLogo {
  id          String  @id @default(cuid())
  routeId     String  @unique
  logoUrl     String
  description String?

  route GtfsRoute @relation(fields: [routeId], references: [route_id])
}

model ImportLog {
  id               String    @id @default(cuid())
  filename         String
  recordsProcessed Int?
  recordsCreated   Int?
  recordsUpdated   Int?
  errors           String?
  startedAt        DateTime  @default(now()) @db.Timestamptz(3)
  completedAt      DateTime? @db.Timestamptz(3)
}
// Official physical infrastructure only. Never a GTFS route/trip foreign key.
model CtpStop {
  id             String   @id @default(cuid())
  identityKey    String   @unique
  source         String   @default("CTP")
  sourceStopId   String
  candidateId    String
  name           String
  lat            Float
  lon            Float
  coordX         String
  coordY         String
  province       String
  canton         String
  district       String?
  sourceMetadata String
  contentHash    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([lat, lon])
  @@index([lon, lat])
  @@index([province])
  @@index([canton])
  @@index([sourceStopId])
  @@map("ctp_stops")
}

// Canonical immutable versions. Existing GTFS tables above are a single-feed
// compatibility projection, replaced only inside publication's transaction.
model DataSource {
  id String @id @default(cuid())
  key String @unique
  kind String
  name String
  endpoint String?
  versions DatasetVersion[]
  ctpStops CtpStopIdentity[]
}
model DatasetVersion {
  id String @id @default(cuid())
  sourceId String
  checksum String
  manifest String @default("{}")
  status String @default("pending")
  // A nullable unique slot enforces one active version per source.
  activeSlot String? @unique
  retrievedAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  source DataSource @relation(fields: [sourceId], references: [id])
  runs ImportRun[]
  agencies GtfsAgencyVersion[]
  stops GtfsStopVersion[]
  routes GtfsRouteVersion[]
  services GtfsService[]
  shapes GtfsShapeVersion[]
  trips GtfsTripVersion[]
  observations CtpStopObservation[]
  @@unique([sourceId, checksum])
}
model ImportRun {
  id String @id @default(cuid())
  datasetVersionId String
  status String @default("pending")
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  rowCounts String @default("{}")
  validation String @default("{}")
  errorSummary String?
  dataset DatasetVersion @relation(fields: [datasetVersionId], references: [id])
  rejected ImportRejection[]
  @@index([datasetVersionId, status])
}
model ImportRejection {
  id String @id @default(cuid())
  importRunId String
  sourceFile String
  rowNumber Int
  reason String
  payload String
  run ImportRun @relation(fields: [importRunId], references: [id])
  @@index([importRunId])
}
model GtfsAgencyVersion {
  id String @id @default(cuid())
  datasetVersionId String
  externalId String
  name String
  url String
  timezone String
  payload String
  dataset DatasetVersion @relation(fields: [datasetVersionId], references: [id])
  routes GtfsRouteVersion[]
  @@unique([datasetVersionId, externalId])
  @@unique([datasetVersionId, id])
}
model GtfsStopVersion {
  id String @id @default(cuid())
  datasetVersionId String
  externalId String
  name String?
  lat Float?
  lon Float?
  locationType Int @default(0)
  parentId String?
  payload String
  dataset DatasetVersion @relation(fields: [datasetVersionId], references: [id])
  parent GtfsStopVersion? @relation("StopHierarchy", fields: [datasetVersionId, parentId], references: [datasetVersionId, id])
  children GtfsStopVersion[] @relation("StopHierarchy")
  stopTimes GtfsStopTimeVersion[]
  reconciliations StopReconciliation[]
  @@unique([datasetVersionId, externalId])
  @@unique([datasetVersionId, id])
}
model GtfsRouteVersion {
  id String @id @default(cuid())
  datasetVersionId String
  externalId String
  agencyId String?
  shortName String?
  longName String?
  routeType Int
  payload String
  dataset DatasetVersion @relation(fields: [datasetVersionId], references: [id])
  agency GtfsAgencyVersion? @relation(fields: [datasetVersionId, agencyId], references: [datasetVersionId, id])
  trips GtfsTripVersion[]
  @@unique([datasetVersionId, externalId])
  @@unique([datasetVersionId, id])
  @@index([agencyId])
}
model GtfsService {
  id String @id @default(cuid())
  datasetVersionId String
  externalId String
  dataset DatasetVersion @relation(fields: [datasetVersionId], references: [id])
  calendar GtfsCalendarVersion?
  exceptions GtfsCalendarDateVersion[]
  trips GtfsTripVersion[]
  @@unique([datasetVersionId, externalId])
  @@unique([datasetVersionId, id])
}
model GtfsCalendarVersion {
  serviceId String @id
  monday Boolean
  tuesday Boolean
  wednesday Boolean
  thursday Boolean
  friday Boolean
  saturday Boolean
  sunday Boolean
  startDate String
  endDate String
  service GtfsService @relation(fields: [serviceId], references: [id])
}
model GtfsCalendarDateVersion {
  serviceId String
  date String
  exceptionType Int
  service GtfsService @relation(fields: [serviceId], references: [id])
  @@id([serviceId, date])
  @@index([date, serviceId])
}
model GtfsShapeVersion {
  id String @id @default(cuid())
  datasetVersionId String
  externalId String
  dataset DatasetVersion @relation(fields: [datasetVersionId], references: [id])
  points GtfsShapePoint[]
  trips GtfsTripVersion[]
  @@unique([datasetVersionId, externalId])
  @@unique([datasetVersionId, id])
}
model GtfsShapePoint {
  shapeId String
  sequence Int
  lat Float
  lon Float
  distance Float?
  shape GtfsShapeVersion @relation(fields: [shapeId], references: [id])
  @@id([shapeId, sequence])
}
model GtfsTripVersion {
  id String @id @default(cuid())
  datasetVersionId String
  externalId String
  routeId String
  serviceId String
  shapeId String?
  payload String
  dataset DatasetVersion @relation(fields: [datasetVersionId], references: [id])
  route GtfsRouteVersion @relation(fields: [datasetVersionId, routeId], references: [datasetVersionId, id])
  service GtfsService @relation(fields: [datasetVersionId, serviceId], references: [datasetVersionId, id])
  shape GtfsShapeVersion? @relation(fields: [datasetVersionId, shapeId], references: [datasetVersionId, id])
  stopTimes GtfsStopTimeVersion[]
  @@unique([datasetVersionId, externalId])
  @@unique([datasetVersionId, id])
  @@index([routeId])
  @@index([serviceId])
  @@index([shapeId])
}
model GtfsStopTimeVersion {
  datasetVersionId String
  tripId String
  sequence Int
  stopId String
  arrivalSeconds Int?
  departureSeconds Int?
  payload String
  trip GtfsTripVersion @relation(fields: [datasetVersionId, tripId], references: [datasetVersionId, id])
  stop GtfsStopVersion @relation(fields: [datasetVersionId, stopId], references: [datasetVersionId, id])
  @@id([tripId, sequence])
  @@index([stopId])
}
// Stable official identity; ctp_stops above is only a current display projection.
model CtpStopIdentity {
  id String @id @default(cuid())
  sourceId String
  externalId String
  active Boolean @default(true)
  reviewStatus String @default("unreviewed")
  currentObservationId String? @unique
  source DataSource @relation(fields: [sourceId], references: [id])
  observations CtpStopObservation[] @relation("CtpHistory")
  current CtpStopObservation? @relation("CtpCurrent", fields: [id, currentObservationId], references: [stopId, id])
  @@unique([sourceId, externalId])
  @@unique([id, currentObservationId])
}
model CtpStopObservation {
  id String @id @default(cuid())
  stopId String
  datasetVersionId String
  sourceStopId String
  name String
  lat Float
  lon Float
  province String
  canton String
  district String?
  provinceCode String?
  cantonCode String?
  coordX String?
  coordY String?
  sourceCrs String
  outputCrs String
  retrievedAt DateTime @db.Timestamptz(3)
  reviewStatus String
  provenance String
  stop CtpStopIdentity @relation("CtpHistory", fields: [stopId], references: [id])
  currentFor CtpStopIdentity? @relation("CtpCurrent")
  dataset DatasetVersion @relation(fields: [datasetVersionId], references: [id])
  reconciliations StopReconciliation[]
  @@unique([stopId, datasetVersionId])
  @@unique([stopId, id])
  @@index([provinceCode, cantonCode])
  @@index([sourceStopId])
  @@index([datasetVersionId])
}
model StopReconciliation {
  id String @id @default(cuid())
  gtfsStopId String
  ctpObservationId String
  distanceMeters Float
  method String
  algorithmVersion String
  status String @default("candidate")
  reviewer String?
  evidence String?
  reviewedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  gtfsStop GtfsStopVersion @relation(fields: [gtfsStopId], references: [id])
  ctpObservation CtpStopObservation @relation(fields: [ctpObservationId], references: [id])
  @@unique([gtfsStopId, ctpObservationId, algorithmVersion])
  @@index([ctpObservationId, status])
}
