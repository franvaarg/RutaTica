generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// GTFS Core Tables
// ============================================

model GtfsAgency {
  agency_id String  @id
  name      String
  url       String
  timezone  String
  phone     String?
  lang      String?
  email     String?

  routes GtfsRoute[]
}

model GtfsCalendar {
  service_id String  @id
  monday     Boolean @default(false)
  tuesday    Boolean @default(false)
  wednesday  Boolean @default(false)
  thursday   Boolean @default(false)
  friday     Boolean @default(false)
  saturday   Boolean @default(false)
  sunday     Boolean @default(false)
  start_date String
  end_date   String

  trips GtfsTrip[]
}

model GtfsCalendarDate {
  id            Int    @id @default(autoincrement())
  service_id    String
  date          String
  exception_type Int

  @@index([date, service_id])
}

model GtfsRoute {
  route_id   String  @id
  agency_id  String
  short_name String?
  long_name  String?
  type       Int     @default(3)
  color      String?
  text_color String?
  sort_order Int?

  agency     GtfsAgency  @relation(fields: [agency_id], references: [agency_id])
  trips      GtfsTrip[]
  stopRoutes StopRoute[]
  fareRules  GtfsFareRule[]
  routeColor RouteColor?
  routeLogo  RouteLogo?

  @@index([agency_id])
}

model GtfsStop {
  stop_id           String  @id
  code              String?
  name              String
  desc              String?
  lat               Float
  lon               Float
  zone_id           String?
  location_type     Int     @default(0)
  parent_station    String?
  wheelchair_boarding Int   @default(0)

  stopTimes  GtfsStopTime[]
  stopRoutes StopRoute[]

  @@index([lat, lon])
}

model GtfsTrip {
  trip_id            String  @id
  route_id           String
  service_id         String
  headsign           String?
  short_name         String?
  direction_id       Int?
  block_id           String?
  shape_id           String?
  wheelchair_accessible Int  @default(0)
  bikes_allowed      Int     @default(0)

  route    GtfsRoute    @relation(fields: [route_id], references: [route_id])
  calendar GtfsCalendar  @relation(fields: [service_id], references: [service_id])
  stopTimes GtfsStopTime[]

  @@index([route_id])
  @@index([service_id])
  @@index([shape_id])
}

model GtfsStopTime {
  id                  Int     @id @default(autoincrement())
  trip_id             String
  stop_id             String
  arrival_time        String
  departure_time      String
  stop_sequence       Int
  stop_headsign       String?
  pickup_type         Int     @default(0)
  drop_off_type       Int     @default(0)
  shape_dist_traveled Float?
  timepoint           Int     @default(1)

  trip GtfsTrip @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  stop GtfsStop @relation(fields: [stop_id], references: [stop_id])

  @@index([trip_id])
  @@index([stop_id])
  @@index([arrival_time])
  @@index([trip_id, stop_sequence])
}

model GtfsShape {
  id                  Int    @id @default(autoincrement())
  shape_id            String
  shape_pt_lat        Float
  shape_pt_lon        Float
  shape_pt_sequence   Int
  shape_dist_traveled Float?

  @@index([shape_id, shape_pt_sequence])
}

model GtfsFareAttribute {
  fare_id          String  @id
  price            Float
  currency_type    String
  payment_method   Int     @default(0)
  transfers        Int     @default(0)
  transfer_duration Int?

  fareRules GtfsFareRule[]
}

model GtfsFareRule {
  id             Int     @id @default(autoincrement())
  fare_id        String
  route_id       String?
  origin_id      String?
  destination_id String?
  contains_id    String?

  fare GtfsFareAttribute @relation(fields: [fare_id], references: [fare_id], onDelete: Cascade)
  route GtfsRoute?       @relation(fields: [route_id], references: [route_id])
}

// ============================================
// Extended Tables
// ============================================

model Company {
  id            String  @id @default(cuid())
  name          String
  phone         String?
  email         String?
  website       String?
  logoUrl       String?
  description   String?
  primaryColor  String?
  secondaryColor String?
  isActive      Boolean @default(true)
}

model StopRoute {
  id        String  @id @default(cuid())
  stopId    String
  routeId   String
  company   String?
  sequence  Int

  stop  GtfsStop  @relation(fields: [stopId], references: [stop_id])
  route GtfsRoute @relation(fields: [routeId], references: [route_id])

  @@index([stopId, routeId])
  @@index([routeId, sequence])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  stopName    String
  routeNumber String
  destination String
  createdAt   DateTime @default(now())
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  originName String
  originLat  Float
  originLon  Float
  destName   String
  destLat    Float
  destLon    Float
  createdAt  DateTime @default(now())
}

model AppSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
}

model RouteConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?
}

model RouteColor {
  id        String  @id @default(cuid())
  routeId   String  @unique
  color     String
  textColor String

  route GtfsRoute @relation(fields: [routeId], references: [route_id])
}

model RouteLogo {
  id          String  @id @default(cuid())
  routeId     String  @unique
  logoUrl     String
  description String?

  route GtfsRoute @relation(fields: [routeId], references: [route_id])
}

model ImportLog {
  id               String    @id @default(cuid())
  filename         String
  recordsProcessed Int?
  recordsCreated   Int?
  recordsUpdated   Int?
  errors           String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
}
// Official physical infrastructure only. Never a GTFS route/trip foreign key.
model CtpStop {
  id             String   @id @default(cuid())
  identityKey    String   @unique
  source         String   @default("CTP")
  sourceStopId   String
  candidateId    String
  name           String
  lat            Float
  lon            Float
  coordX         String
  coordY         String
  province       String
  canton         String
  district       String?
  sourceMetadata String
  contentHash    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lat, lon])
  @@index([lon, lat])
  @@index([province])
  @@index([canton])
  @@index([sourceStopId])
  @@map("ctp_stops")
}
